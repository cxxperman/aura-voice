{
  "name": "aura-voice",
  "productName": "Aura",
  "version": "0.28.0",
  "description": "Студийная обработка голоса с микрофона в реальном времени",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icon.js",
    "test:family": "node scripts/family-test.js",
    "test:main": "node scripts/main-test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "author": "Aura",
  "license": "MIT",
  "build": {
    "appId": "app.aura.voice",
    "productName": "Aura",
    "files": [
      "main.js",
      "preload.js",
      "hub-client.js",
      "family.js",
      "ai-convert.js",
      "ai-worker.js",
      "ai-live.js",
      "ai-templates/**",
      "ai-pth.js",
      "app/**",
      "assets/**",
      "!app/dev-fixtures.js",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "Aura",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "Aura-Setup-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "^1.31.1"
  }
}
